# Copy to .env (or set these in your shell) and adjust. Every one has a
# working default, so the server starts with none of them set.

# --- where it listens -------------------------------------------------------
TELLY_HOST=0.0.0.0          # 0.0.0.0 so other devices on the network can reach it
TELLY_PORT=8443

# --- HTTPS ------------------------------------------------------------------
# Set both to serve TLS directly. On a VPS behind nginx or Caddy, leave them
# empty and terminate TLS there instead, then set TELLY_TRUST_PROXY=true.
TELLY_TLS_CERT=
TELLY_TLS_KEY=
TELLY_TRUST_PROXY=false

# --- data -------------------------------------------------------------------
TELLY_DATA_DIR=./data
# TELLY_DB=./data/telly.db

# Signing key for playback tickets. Generated into data/secret.key on first
# run if unset. Set it explicitly when you move to a server.
TELLY_SECRET=

# --- sessions ---------------------------------------------------------------
TELLY_ACCESS_TTL=1800       # 30 minutes
TELLY_REFRESH_TTL=2592000   # 30 days
TELLY_TICKET_TTL=300        # 5 minutes

# --- playback ---------------------------------------------------------------
# redirect: the server hands the player the upstream address and steps aside.
# proxy:    the server relays the video, so the address never reaches the device.
TELLY_STREAM_MODE=redirect

# --- limits -----------------------------------------------------------------
TELLY_RL_LOGIN=10           # login attempts per minute
TELLY_RL_API=300            # API calls per minute
TELLY_PLAYLIST_TTL=21600    # refetch a playlist at most every 6 hours
TELLY_DEFAULT_MAX_DEVICES=2
