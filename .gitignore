# Dependencies and build output
node_modules/
outside/mobile/www/

# Capacitor / Xcode / Gradle build products
outside/mobile/ios/App/App/public/
outside/mobile/ios/App/build/
outside/mobile/ios/App/Pods/
outside/mobile/ios/App/App.xcworkspace/xcuserdata/
outside/mobile/ios/App/App.xcodeproj/xcuserdata/
outside/mobile/ios/App/App.xcodeproj/project.xcworkspace/xcuserdata/
outside/mobile/ios/App/.build/
DerivedData/
*.xcuserstate

outside/mobile/android/build/
outside/mobile/android/app/build/
outside/mobile/android/app/src/main/assets/public/
outside/mobile/android/.gradle/
outside/mobile/android/local.properties
outside/mobile/android/.idea/
*.iml

# Signing material. None of this ever belongs in a repository: a leaked
# keystore means somebody else can ship an update to your users, and an Android
# upload key cannot be replaced without asking Google to reset it.
*.keystore
*.jks
*.p12
*.p8
*.mobileprovision
*.cer
*.certSigningRequest
keystore.properties
outside/mobile/android/keystore.properties
outside/mobile/.env
outside/mobile/.env.*

# Built app packages — rebuilt from source, never reviewed as a diff
*.apk
*.aab
*.ipa
*.app.zip

.DS_Store

# V2 training dataset payload. The registers (sessions.csv, sources.csv) ARE
# committed — they are the part worth reviewing in a diff. The photographs are
# not: pages.yml publishes this repository as-is, so a committed road picture
# is a public download of somebody's number plate. See training/README.md.
training/dataset/images/**
training/dataset/labels/**
training/dataset/incoming/**
# The split directories themselves stay in git, or the negation below cannot
# reach inside them: git will not re-include a file whose parent it excluded.
!training/dataset/images/*/
!training/dataset/labels/*/
!training/dataset/**/.gitkeep
training/build/
training/test/report/
__pycache__/
*.pyc
