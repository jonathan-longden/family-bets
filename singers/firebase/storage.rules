rules_version = '2';

// Clips and their poster frames. Anyone signed in can watch; only the person
// who posted a clip can write or replace it, and the file has to actually be a
// video of a sane size. Filenames are the clip id, which the app generates.
service firebase.storage {
  match /b/{bucket}/o {

    match /clips/{clipFile} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && request.resource.size < 100 * 1024 * 1024
                   && request.resource.contentType.matches('video/.*');
      allow delete: if request.auth != null;
    }

    match /posters/{posterFile} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && request.resource.size < 2 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
